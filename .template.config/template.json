{
  "$schema": "http://json.schemastore.org/template",
  "author": "YourName",
  "classifications": ["Web", "API", "Clean Architecture"],
  "identity": "CleanArchitecture.Template",
  "name": "Clean Architecture API Solution",
  "shortName": "cleanarch",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Api",
  "preferNameDirectory": true,
  "symbols": {
    "projectName": {
      "type": "parameter",
      "defaultValue": "CleanArchitecture",
      "replaces": "Api"
    },
    "dbName": {
      "type": "parameter",
      "defaultValue": "ApiDb",
      "replaces": "ApiDb"
    }
  },
  "sources": [
    {
      "exclude": [
        ".git/**/*",
        ".git/**",
        ".git/",
        ".vs/**/*",
        "**/bin/**/*",
        "**/obj/**/*",
        ".template.config/**/*"
      ]
    }
  ]
}
